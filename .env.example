# Copy to .env for local use. Never commit .env.
PORT=3000
NODE_ENV=development

# GitHub OAuth app (local app uses the localhost callback)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Long random string, see README for how to generate
JWT_SECRET=replace_with_a_long_random_secret

# Optional, defaults to ./data/capsules.db
DATABASE_PATH=./data/capsules.db
